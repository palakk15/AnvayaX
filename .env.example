# Copy to .env; insert keys locally. This file contains no working credentials.
# Environment variables override this file. Never commit .env.
GROQ_API_KEYS=[]
GROQ_API_KEY=
# Prefer one GROQ_API_KEY. The legacy GROQ_API_KEYS array remains supported.
# Website: copy to .env.local and restart npm run dev after inserting a key.
# Example syntax: GROQ_API_KEYS=["your-first-key", "your-second-key"]
GROQ_MODEL=openai/gpt-oss-120b
BHARATBLEND_DATA_DIR=artifacts/research_v2
